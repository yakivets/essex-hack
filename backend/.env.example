# Copy to .env and fill in. Auth comes from ~/.oci/config (never put keys here).
#
# FAKE_OCI=1 -> canned demo response (no cloud). Good for frontend/dev work.
# FAKE_OCI=0 -> real OCI Generative AI pipeline (fill the OCI_* values).
FAKE_OCI=1
CACHE_TTL_SECONDS=3600

# --- Only needed when FAKE_OCI=0 (values from the GenAI Chat playground "View code") ---
# Region that hosts Generative AI, e.g. eu-frankfurt-1 / us-chicago-1 / uk-london-1
OCI_REGION=
# Endpoint = https://inference.generativeai.<OCI_REGION>.oci.oraclecloud.com
OCI_GENAI_ENDPOINT=
# Compartment OCID (Identity & Security -> Compartments)
OCI_COMPARTMENT_ID=
# Chat model id, e.g. cohere.command-r-plus-08-2024 or meta.llama-3.3-70b-instruct
OCI_GENAI_CHAT_MODEL=
