# Copy to .env and fill in. Auth comes from ~/.oci/config (never put keys here).
#
# FAKE_OCI=1 -> canned demo response (no cloud). Good for frontend/dev work.
# FAKE_OCI=0 -> real OCI Generative AI pipeline (fill the OCI_* values).
FAKE_OCI=1
CACHE_TTL_SECONDS=3600

# --- Accounts + dashboard ---
# SQLite locally (no setup). Swap to Oracle ADB 23ai later WITHOUT code changes:
#   DATABASE_URL=oracle+oracledb://ADMIN:<pw>@<adb_high>  (set TNS_ADMIN to the wallet)
DATABASE_URL=sqlite:///./pactpilot.db
# Secret used to sign login tokens (HS256). Change this outside local dev.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_HOURS=168

# --- Only needed when FAKE_OCI=0 (values from the GenAI Chat playground "View code") ---
# Region that hosts Generative AI, e.g. eu-frankfurt-1 / us-chicago-1 / uk-london-1
OCI_REGION=
# Endpoint = https://inference.generativeai.<OCI_REGION>.oci.oraclecloud.com
OCI_GENAI_ENDPOINT=
# Compartment OCID (Identity & Security -> Compartments)
OCI_COMPARTMENT_ID=
# Chat model id, e.g. cohere.command-r-plus-08-2024 or meta.llama-3.3-70b-instruct
OCI_GENAI_CHAT_MODEL=
# Embedding model id, e.g. cohere.embed-english-v3.0 (1024-dim)
OCI_GENAI_EMBED_MODEL=

# --- Oracle Autonomous DB 23ai vector store (optional) ---
# Leave ADB_DSN empty to use the in-memory cosine fallback (no DB needed).
# When set, benchmark + chat RAG run against native VECTOR columns via oracledb.
ADB_USER=ADMIN
ADB_PASSWORD=
ADB_DSN=
# Path to the unzipped mTLS wallet (becomes TNS_ADMIN)
TNS_ADMIN=
# Optional: password you set when downloading the wallet zip
WALLET_PASSWORD=
EMBED_DIM=1024
